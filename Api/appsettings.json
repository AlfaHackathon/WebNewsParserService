{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Api": "Information"
    }
  },
  "AllowedHosts": "*",
  "Internal": {
    "Secret": ""
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "news-parser"
  },
  "Tass": {
    "BaseAddress": "https://tass.ru"
  },
  "Alfa": {
    "BaseAddress": "https://alfabank.ru",
    "Rubric": "news",
    "Limit": 20,
    "MaxPagesPerPoll": 5,
    "MaxArticleFetchPerPoll": 10,
    "ChallengeWaitTimeoutSeconds": 90,
    "ManualCookies": ""
  },
  "Worker": {
    "TassPollIntervalSeconds": 30,
    "AlfaPollIntervalSeconds": 300,
    "RbcPollIntervalSeconds": 300
  },
  "Rbc": {
    "BaseAddress": "https://www.rbc.ru",
    "FeedPagePath": "/quote",
    "MaxArticleFetchPerPoll": 10
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "news-parser.news",
    "GroupId": "news-parser"
  },
  "Swagger": {
    "Enabled": true
  }
}
