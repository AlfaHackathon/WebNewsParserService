{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Api": "Information"
    }
  },
  "AllowedHosts": "*",
  "Internal": {
    "Secret": ""
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "news-parser"
  },
  "Tass": {
    "BaseAddress": "https://tass.ru"
  },
  "Worker": {
    "TassPollIntervalSeconds": 30
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "news-parser.news",
    "GroupId": "news-parser"
  },
  "Swagger": {
    "Enabled": true
  }
}
